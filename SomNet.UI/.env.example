# SomNet.UI — local go2rtc viewer URLs (Phase 2–3)
# Phase 3: feeds load only during an active session (API session tokens).
# Requires go2rtc running — see SomNet.Edge/README.md

# mse = Chrome/Edge on Windows; webrtc also works after libx264 exec in go2rtc.yaml
VITE_VIDEO_VIEWER_MODE=mse

# Browser DevTools [video] schedule/hide logs (not the API console). Set false to silence.
# VITE_VIDEO_DEBUG=false

# Same-origin paths — proxied to go2rtc in Development (see appsettings.Development.json)
VITE_VIDEO_FRONT_URL=/go2rtc/stream.html?src=front

# Phase 1a (webcam only): same as front — one producer, both panels smooth.
# Layout A-dev (2x webcam): src=rear | Phase 1a mirror: src=front
VITE_VIDEO_REAR_URL=/go2rtc/stream.html?src=rear
