{
  "Logging": {
    "ShowSql": false,
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "SomNet",
    "Audience": "SomNet.UI",
    "DeviceAudience": "SomNet.Device",
    "ExpireMinutes": 480,
    "DeviceExpireDays": 365
  }
}
