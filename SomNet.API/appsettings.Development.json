{
  "Logging": {
    "ShowSql": false,
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Hardware": {
    "StrokeMs": {
      "AbsoluteMinimum": 25,
      "AbsoluteMaximum": 800
    },
    "ReachabilityPing": {
      "Enabled": true,
      "IntervalSeconds": 15,
      "DeviceIps": [ "192.168.1.172" ]
    }
  },
  "Video": {
    "StreamTokenExpireMinutes": 30,
    "StreamTokenAudience": "SomNet.VideoStream",
    "FrontEmbedPath": "/go2rtc/stream.html?src=front",
    "RearEmbedPath": "/go2rtc/stream.html?src=rear"
  },
  "Video:Snapshots": {
    "Enabled": true,
    "StorageRoot": "../data/snapshots",
    "Go2RtcBaseUrl": "http://localhost:1984",
    "RearSettleDelayMs": 1000
  },
  "Jwt": {
    "Key": "SomNet-Dev-Jwt-Signing-Key-Change-For-Production-2026",
    "Issuer": "SomNet",
    "Audience": "SomNet.UI",
    "DeviceAudience": "SomNet.Device",
    "ExpireMinutes": 480
  },
  "ReverseProxy": {
    "Routes": {
      "go2rtc": {
        "ClusterId": "go2rtc",
        "Match": {
          "Path": "/go2rtc/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/go2rtc" }
        ]
      }
    },
    "Clusters": {
      "go2rtc": {
        "Destinations": {
          "local": {
            "Address": "http://localhost:1984/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:30:00"
        }
      }
    }
  }
}
