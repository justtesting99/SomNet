{
  "Logging": {
    "ShowSql": false,
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Hardware": {
    "StrokeMs": {
      "AbsoluteMinimum": 25,
      "AbsoluteMaximum": 30000
    },
    "ReachabilityPing": {
      "Enabled": true,
      "IntervalSeconds": 15,
      "DeviceIps": [ "192.168.1.172" ]
    }
  },
  "Jwt": {
    "Key": "SomNet-Dev-Jwt-Signing-Key-Change-For-Production-2026",
    "Issuer": "SomNet",
    "Audience": "SomNet.UI",
    "DeviceAudience": "SomNet.Device",
    "ExpireMinutes": 480
  }
}
