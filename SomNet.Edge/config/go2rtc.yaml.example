# SomNet Edge — go2rtc example (Layout A-dev: 2× USB webcam — active)
# IP camera rear (Phase 1b) on hold (V1-D9).
# Copy to D:\SomNet.Edge\go2rtc.yaml (or SOMNET_EDGE_HOME) — never commit credentials.

log:
  level: info

api:
  listen: ":1984"
  # Required for SomNet UI iframe embed via API /go2rtc proxy (Phase 2 bench)
  origin: "*"

rtsp:
  listen: ":8554"

streams:
  # --- Windows (Phase 1a) ---
  # Run list-camera-devices.ps1 — use video=0, video=1, ... (DirectShow index)
  # Do NOT use Linux-only lavfi/testsrc for rear on Windows go2rtc builds.
  # Windows: if WebRTC shows MP4V-ES codec error, use exec libx264 (see D:\SomNet.Edge\go2rtc.yaml)
  front:
    - ffmpeg:device?video=0#video=h264
  # Or explicit transcode, e.g.:
  # - 'exec:ffmpeg -hide_banner -f dshow -i "video=HD User Facing" -c:v libx264 -preset ultrafast -tune zerolatency -pix_fmt yuv420p -g 25 -an -f mpegts -'

  # --- Layout A-dev (bench): two USB webcams — V1-D10 ---
  # Run list-camera-devices.ps1; replace device names below.
  # Use exec libx264 on both (same fix as front MP4V-ES / WebRTC issues).
  # rear:
  #   - 'exec:ffmpeg -hide_banner -f dshow -i "video=SECOND CAM NAME" -c:v libx264 -preset ultrafast -tune zerolatency -pix_fmt yuv420p -g 25 -an -f mpegts -'

  # --- Phase 1b: IP rear (Layout A production) — Galayou G7 / G2 ---
  # Enable RTSP in Wansview Cloud → Settings → Local application (see Documents/14-Video-Phase-1b-Galayou-G2-Setup.md)
  # Test first: .\SomNet.Edge\scripts\test-rtsp.ps1 -Url 'rtsp://USER:PASS@192.168.1.50:554/live/ch1'
  # rear:
  #   - rtsp://USER:PASS@192.168.1.50:554/live/ch1#rtsp_transport=tcp
  # Main stream: /live/ch0 — sub stream (preferred for live): /live/ch1

  # --- Layout B: both IP ---
  # front:
  #   - rtsp://USER:PASS@192.168.1.101:554/stream1
  # rear:
  #   - rtsp://USER:PASS@192.168.1.102:554/stream1
